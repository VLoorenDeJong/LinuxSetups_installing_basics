# hostings.conf: the whole machine in one file.
#
# Written by install_hostings.sh because /etc/hostings had no config. Fill in
# what the chosen modules need (the conf lines in modules.conf), then run
# install_hostings.sh again.
# Every other setting is optional: remove the "# " in front of one to set it,
# and a script uses its own default for any that stay commented.
#
# A second file beside this one, hostings.test.conf, is used instead while
# MACHINE_IS_LIVE is not yes: build and test a machine without it claiming
# to be the live one.

MACHINE_IS_LIVE = no

